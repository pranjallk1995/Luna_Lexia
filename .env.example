# Copy this file to .env and replace every placeholder before starting Lexia.

# Password of this app's role on Luna Sentia's shared PostgreSQL (luna-sentia-db).
# Must equal LUNALEXIA_DB_PASSWORD in Luna_Sentia/.env.
POSTGRES_PASSWORD=lunalexia-dev

# Model served by Luna Sentia; it must be listed in Sentia's SENTIA_MODELS.
DOCUMENT_MODEL=qwen3-vl:8b-instruct
# Send the first pages' images beside the parsed text, so the model sees the layout.
PAGE_IMAGES_WITH_TEXT=true
# Embedding model for semantic search (also in Sentia's SENTIA_MODELS) and its vector size.
# Changing the dimensions rebuilds the semantic index.
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
# Where Docling runs its layout, table, and OCR models: auto, cuda, or cpu.
DOCLING_DEVICE=auto
# Optional: Sentia's Ollama endpoint on the shared luna_sentia_network.
OLLAMA_URL=http://luna-sentia-ollama:11434

# Public MCP/API origin used when Lexia creates stable document URLs.
# Leave blank when public document URLs are not needed.
LUNALEXIA_PUBLIC_BASE_URL=

# Private credential for the UI and peer apps such as Luna Fiora. This is not issued by
# any service: make up your own random value of at least 32 characters, e.g. with
# `openssl rand -hex 32`.
# The default works on localhost; set your own before giving this app a public (https)
# address, and the same value as LUNALEXIA_API_TOKEN in Luna_Sentia/.env.
# LUNALEXIA_API_TOKEN=lunalexia-dev-token-for-localhost-only

# Who may use this app, among the people Luna Sentia lets sign in: blank (the default) for
# Sentia's owner only, * for all of them, or a comma-separated list. The owner always may.
# LUNALEXIA_ALLOWED_EMAILS=*

# Public origin of the MCP server, used for its icon URLs.
# Must be HTTPS when exposed publicly; plain HTTP is accepted only on localhost.
MCP_PUBLIC_URL=http://localhost:18001
# The address people open this app's web UI at; the get_ui_link MCP tool gives it out.
UI_PUBLIC_URL=http://localhost:18501

# Single sign-on through Luna Sentia: the auth service's public address (SENTIA_AUTH_PUBLIC_URL
# in Luna_Sentia/.env), and its address on luna_sentia_network; https://auth.example.com
# with a tunnel.
LUNA_SSO_URL=http://localhost:19001
LUNA_SSO_INTERNAL_URL=http://luna-sentia-auth:8000

# Optional: Google OAuth client for Google Drive and Gmail import (blank = both off). It can
# be the same client as SENTIA_AUTH_GOOGLE_CLIENT_ID/SECRET in Luna_Sentia/.env; add
# <MCP_PUBLIC_URL>/api/drive/callback and <MCP_PUBLIC_URL>/api/gmail/callback to its redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
